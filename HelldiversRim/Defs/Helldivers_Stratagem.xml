<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 落点蓝色光柱（呼叫动画，Mote） ==================== -->
  <ThingDef>
    <defName>Helldivers_BeaconPillar</defName>
    <thingClass>Mote</thingClass>
    <category>Mote</category>
    <graphicData>
      <texPath>Things/Mote/OrbitalBeamTargeting</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3,3)</drawSize>
      <color>
        <r>0.25</r>
        <g>0.55</g>
        <b>1</b>
        <a>1</a>
      </color>
    </graphicData>
    <altitudeLayer>AboveFloor</altitudeLayer>
    <comps>
      <li Class="CompGlower">
        <glowRadius>4</glowRadius>
        <overlightRadius>5</overlightRadius>
      </li>
    </comps>
    <mote>
      <fadeInTime>0.25</fadeInTime>
      <solidTime>1.8</solidTime>
      <fadeOutTime>0.4</fadeOutTime>
    </mote>
  </ThingDef>

  <!-- ==================== 便携呼叫器（持续型副手装备） ==================== -->
  <!--
    携带者获得"呼叫战备"Gizmo，可随时选点空投哨戒炮塔；不消耗、不与主武器冲突
    （equipmentType=Secondary 占副手槽）。呼叫逻辑见 CompStratagemCaller。
  -->
  <ThingDef>
    <defName>Helldivers_StratagemBeacon</defName>
    <label>stratagem caller</label>
    <description>A handheld stratagem uplink. Equip it in your off-hand and call in a mortar sentry from orbit at any marked drop zone; it never runs out.</description>
    <category>Item</category>
    <thingClass>ThingWithComps</thingClass>
    <eType>Weapon</eType>
    <equipmentType>Secondary</equipmentType>
    <equippedStatOffsets />
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>300</MarketValue>
      <Mass>1.5</Mass>
    </statBases>
    <comps>
      <li Class="HelldiversRim.CompProperties_StratagemCaller">
        <mortarSentryDef>Helldivers_MortarSentry</mortarSentryDef>
        <podOpenDelay>60</podOpenDelay>
        <beaconPillarDef>Helldivers_BeaconPillar</beaconPillarDef>
      </li>
    </comps>
    <graphicData>
      <texPath>Things/Item/Resource/Components/ComponentIndustrial</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawGUIOverlay>true</drawGUIOverlay>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>1</stackLimit>
    <rotatable>false</rotatable>
  </ThingDef>

</Defs>
