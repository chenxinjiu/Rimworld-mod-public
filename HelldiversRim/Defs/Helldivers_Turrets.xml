<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 迫击炮弹（爆炸抛射物，非掉落物） ==================== -->
  <ThingDef>
    <defName>Helldivers_Proj_SentryMortarShell</defName>
    <label>sentry mortar shell</label>
    <thingClass>Projectile_Explosive</thingClass>
    <eType>Unknown</eType>
    <alwaysHaulable>false</alwaysHaulable>
    <neverHaulable>true</neverHaulable>
    <projectile Class="ProjectileProperties">
      <damageDef>Explosion</damageDef>
      <damageAmountBase>30</damageAmountBase>
      <explosionRadius>4.5</explosionRadius>
      <speed>30</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/MortarShell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <altitudeLayer>OnTop</altitudeLayer>
    <drawGuiOverlay>false</drawGuiOverlay>
  </ThingDef>

  <!-- ==================== 哨戒炮管（决定射击参数） ==================== -->
  <ThingDef>
    <defName>Helldivers_Gun_SentryMortar</defName>
    <label>sentry mortar tube</label>
    <thingClass>ThingWithComps</thingClass>
    <eType>Item</eType>
    <verbs>
      <li>
        <verbClass>HelldiversRim.Verb_SentryMortar</verbClass>
        <hasStandardCommand>false</hasStandardCommand>
        <warmupTicks>20</warmupTicks>
        <range>48</range>
        <defaultProjectile>Helldivers_Proj_SentryMortarShell</defaultProjectile>
        <verbProps IsCombatWeapon="True">
          <defaultLabel>sentry mortars</defaultLabel>
          <targetParams>
            <canTargetLocations>true</canTargetLocations>
            <canTargetPawns>true</canTargetPawns>
          </targetParams>
        </verbProps>
      </li>
    </verbs>
    <graphicData>
      <texPath>Things/Weapon_Ranged/BasicCannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
  </ThingDef>

  <!-- ==================== 迫击炮哨戒（一次性自动炮塔建筑） ====================
       空投/建造即使用，不带电网；自带内部弹药，打空后自毁并分解为废料。 -->
  <ThingDef ParentName="BaseTurretGun">
    <defName>Helldivers_MortarSentry</defName>
    <label>mortar sentry</label>
    <description>A one-shot auto-targeting mortar turret dropped from Super Earth. It carries its own internal ammunition; once spent, it self-destructs into scrap.</description>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <MarketValue>1600</MarketValue>
    </statBases>
    <building>
      <ai_combat>true</ai_combat>
      <turretGunDef>Helldivers_Gun_SentryMortar</turretGunDef>
      <turretId>HelldiversMortarSentry</turretId>
      <range>48</range>
      <shotSweepPieces>2</shotSweepPieces>
    </building>
    <comps>
      <!-- 不再需要电网：一次性自带弹药 -->
      <li Class="HelldiversRim.CompProperties_SentryLifespan">
        <shots>18</shots>
        <explodeRadius>2.8</explodeRadius>
        <explodeDamage>30</explodeDamage>
        <scrapDef>Steel</scrapDef>
        <scrapCount>60</scrapCount>
      </li>
      <li Class="CompToggleableOverlay"/>
    </comps>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </ThingDef>

</Defs>