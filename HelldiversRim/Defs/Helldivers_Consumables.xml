<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== Stim（战斗兴奋剂 / 成瘾品） ==================== -->
  <ThingDef>
    <defName>Helldivers_Stim</defName>
    <label>combat stim</label>
    <description>A potent Helldiver combat stim. One injection instantly clears all wounds, restores missing limbs, and supercharges reflexes for a full day. However, it creates a severe chemical dependency — miss a dose and suffer the consequences.</description>
    <category>Item</category>
    <thingClass>Thing_Ingestible</thingClass>
    <eType>Item</eType>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>120</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <graphicData>
      <texPath>Things/Item/Resource/Pharmaceuticals/Medicine/MedicineIndustrial</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawGUIOverlay>true</drawGUIOverlay>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>6</stackLimit>
    <rotatable>false</rotatable>
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <ingestible>
      <drugCategory>Hard</drugCategory>
      <foodType>Processed, Fluid</foodType>
      <baseIngestTicks>80</baseIngestTicks>
      <ingestSound>Ingest_Inject</ingestSound>
      <ingestCommandString>Inject {0}</ingestCommandString>
      <ingestReportString>Injecting {0}.</ingestReportString>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <chairSearchRadius>0</chairSearchRadius>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Helldivers_StimHigh</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <!-- ==================== Ration Bar（补给口粮） ==================== -->
  <ThingDef>
    <defName>Helldivers_RationBar</defName>
    <label>ration bar</label>
    <description>A compact, high-energy survival bar issued to every Helldiver. Tastes like pure liberty.</description>
    <category>Item</category>
    <thingClass>Thing_Ingestible</thingClass>
    <eType>Item</eType>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <MarketValue>14</MarketValue>
    </statBases>
    <graphicData>
      <texPath>Things/Item/Resource/Meal/MealSurvivalPack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawGUIOverlay>true</drawGUIOverlay>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>20</stackLimit>
    <rotatable>false</rotatable>
    <ingestible>
      <foodTypeFlags>Meal</foodTypeFlags>
      <nutrition>0.45</nutrition>
      <tasteThought>Thought_HadMealSurvival</tasteThought>
      <maxNumToIngestAtOnce>8</maxNumToIngestAtOnce>
    </ingestible>
  </ThingDef>

  <!-- ==================== Sample（勘测样本资源） ==================== -->
  <ThingDef>
    <defName>Helldivers_Sample</defName>
    <label>prospected sample</label>
    <description>A classified biological sample, valuable for future Super-Earth research projects. Collect them from the wilds.</description>
    <category>Item</category>
    <thingClass>Thing_Resource</thingClass>
    <eType>Item</eType>
    <countAsResource>true</countAsResource>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>80</MarketValue>
      <Mass>0.2</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Item/Resource/Steel/Steel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawGUIOverlay>true</drawGUIOverlay>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>75</stackLimit>
    <rotatable>false</rotatable>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <storeCategories>
      <li>ResourcesRaw</li>
    </storeCategories>
  </ThingDef>

</Defs>
