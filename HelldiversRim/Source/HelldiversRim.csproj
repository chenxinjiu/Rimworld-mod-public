<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>HelldiversRim</AssemblyName>
    <RootNamespace>HelldiversRim</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      改成引用本机游戏目录里的 Managed dll，不再用 NuGet 的 Krafs.Rimworld.Ref 1.5 包（与 1.6 不匹配）。
      RimWorld 默认装在 Steam 公共库。可命令行覆盖：
        dotnet build -p:RimWorldPath="E:\Other\SteamLibrary\..."

      如果继续用 <RimWorldPath>xxx</RimWorldPath> 写死在 csproj 里，
      请在下方改用你自己机器的真实路径。
    -->
    <SteamInstall Condition="'$(SteamInstall)' == ''">E:\steam</SteamInstall>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">$(SteamInstall)\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldManaged>$(RimWorldPath)\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(RimWorldManaged)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 编译后把 dll 拷进 mod 的 Assemblies 目录 -->
  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)HelldiversRim.dll" DestinationFolder="$(MSBuildProjectDirectory)/../Assemblies" />
  </Target>

</Project>