<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>HelldiversRim</AssemblyName>
    <RootNamespace>HelldiversRim</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- RimWorld 安装路径：你的 Steam 在 E:\steam，游戏在 E:\steam\steamapps\common\RimWorld。
         如需换机器，改这里一行即可，或命令行 /p:RimWorldPath= 覆盖 -->
    <SteamInstall Condition="'$(SteamInstall)' == ''">E:\steam</SteamInstall>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">$(SteamInstall)\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldManaged>$(RimWorldPath)\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接引用游戏 Managed 目录下所有 dll（含 Assembly-CSharp、UnityEngine、0Harmony）
         这样不再依赖 NuGet 包。Private=false 表示不把这些 dll 拷进输出目录。 -->
    <Reference Include="$(RimWorldManaged)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 编译后把 dll 拷进 mod 的 Assemblies 目录 -->
  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)HelldiversRim.dll" DestinationFolder="$(MSBuildProjectDirectory)/../Assemblies" />
  </Target>

</Project>